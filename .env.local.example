# =========================================================
# SUPABASE (database utama: jurusan, praktikum, kelompok, nilai, tugas, dll)
# Buat project BARU di https://supabase.com/dashboard -> New Project
# Lalu jalankan supabase/schema.sql di SQL Editor project tsb (lihat supabase/README.md)
# Ambil nilai di bawah dari: Project Settings > API
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key -- HANYA dipakai di server (API routes), JANGAN pernah expose ke client / commit ke git
SUPABASE_SERVICE_ROLE_KEY=

# Kode akses untuk membuat akun ASISTEN baru lewat halaman Daftar (agar tidak sembarang
# orang bisa daftar jadi asisten). Bagikan kode ini hanya ke tim asisten/koordinator.
# Kosongkan untuk menonaktifkan pengecekan ini (tidak disarankan untuk produksi).
ASISTEN_SIGNUP_CODE=ical-asisten-2026

# Secret untuk HMAC penandatanganan QR Absensi berputar (~30 detik).
# Fallback otomatis ke SUPABASE_SERVICE_ROLE_KEY kalau kosong, tapi disarankan diisi sendiri untuk production.
QR_ATTEND_SECRET=

# =========================================================
# CLOUDFLARE R2 (tempat file tugas pertama kali disimpan)
# Ambil dari: Cloudflare Dashboard > R2 > Manage API Tokens
# =========================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ical-pengumpulan-tugas
# URL publik/dev bucket (opsional, untuk link "Lihat" file). Contoh: https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Bucket R2 TERPISAH khusus untuk file modul PDF & foto profil asisten.
# Dipisah dari bucket tugas di atas supaya lebih rapi (siklus hidup file beda:
# modul jarang berubah, tugas dihapus/dipindah ke Drive setelah dinilai).
# Buat bucket baru di R2 dengan nama yang sama seperti nilai di bawah ini.
R2_MODUL_BUCKET_NAME=ical-modul

# =========================================================
# GOOGLE DRIVE (arsip final, dipindahkan manual dari R2 lewat tombol "Simpan ke Google Drive")
# Buat Service Account di Google Cloud Console > IAM > Service Accounts,
# aktifkan Google Drive API, lalu share folder Drive tujuan ke email service account-nya.
# =========================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
